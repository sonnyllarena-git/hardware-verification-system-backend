# Copy to .env and fill in real values. Never commit .env.

PORT=3001
NODE_ENV=development

# Supabase (see CLAUDE_Supabase.md §8 for the project ref)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Resend (applicant verification emails — see services/emailService.js)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Shared secret gating the compliance-requirements write endpoints (see middleware/adminAuth.js)
ADMIN_API_KEY=your-admin-api-key

# Azure AD (deferred — local testing lane doesn't need these yet)
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
